TYPESAFE_API_KEY=
# Either name works. Do not commit the value. The monorepo .env uses JEV_API_KEY.
# JEV_API_KEY=

# Local write-up model (OpenAI-compatible). Ollama default shown.
# WRITE_BASE_URL=http://127.0.0.1:11434/v1
# WRITE_MODEL=qwen3.8
# WRITE_API_KEY=
# OPENAI_BASE_URL, OPENAI_MODEL, and OPENAI_API_KEY are accepted as aliases.

# Optional: override the published Jev 1.13 price used for run history.
# JEV_INPUT_USD_PER_MTOK=0.042
# JEV_OUTPUT_USD_PER_MTOK=0

# Optional: folder the dashboard Browse button opens first.
# JEV_WORKSPACE=/path/to/LM-Apps-Monorepo
