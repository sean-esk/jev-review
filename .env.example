# Copy this file to .env in THIS repo (jev-review), not the monorepo:
#   cp .env.example .env
# npm scripts load it with --env-file=.env. Do not commit .env.

# --- Jev (required) ----------------------------------------------------------
# TypeSafe/Jev paid scoring. Either name works.
# Fastest path: copy the JEV_API_KEY line from ../LM-Apps-Monorepo/.env
# Or create a key at https://console.typesafe.ai/settings/keys and paste it here.
JEV_API_KEY=
# TYPESAFE_API_KEY=

# --- Local write-up model (OpenAI-compatible) --------------------------------
# Jev only returns scores. The dashboard then POSTs each finding to:
#   {WRITE_BASE_URL}/chat/completions
# On the Mac Studio, 127.0.0.1 is correct when Ollama or LM Studio is local.
#
# Ollama (default):
WRITE_BASE_URL=http://127.0.0.1:11434/v1
WRITE_MODEL=qwen3.8
#
# LM Studio (enable the local server; default port 1234):
# WRITE_BASE_URL=http://127.0.0.1:1234/v1
# WRITE_MODEL=the-exact-model-name-shown-in-lm-studio
#
# If the dashboard runs on another machine, use the Studio LAN address instead:
# WRITE_BASE_URL=http://192.168.x.x:11434/v1
#
# Optional. Local servers usually ignore this; a dummy value is sent if empty.
# WRITE_API_KEY=local
#
# OPENAI_BASE_URL, OPENAI_MODEL, and OPENAI_API_KEY are accepted as aliases.

# --- Optional ----------------------------------------------------------------
# Folder the dashboard Browse button opens first. Defaults to a sibling
# LM-Apps-Monorepo directory when that folder exists.
# JEV_WORKSPACE=/Users/sean/Software/LevelMethod/LM-Apps-Monorepo
#
# Published Jev 1.13 price used for run-history cost. Override only if it changes.
# JEV_INPUT_USD_PER_MTOK=0.042
# JEV_OUTPUT_USD_PER_MTOK=0
